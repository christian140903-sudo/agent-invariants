{
  "name": "agent-invariants",
  "version": "0.1.1",
  "description": "Deterministic behavior contracts for AI agents. Catch permission, stop, retry, scope, and false-completion regressions across agent changes.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "agent-invariants": "dist/src/index.js",
    "agent-invariants-mcp": "dist/src/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js serve",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test dist/test/evaluator.test.js dist/test/schema-parser.test.js dist/test/reports.test.js dist/test/mcp.test.js",
    "smoke:pack": "node scripts/release-smoke.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test && npm run smoke:pack"
  },
  "keywords": [
    "ai-agent",
    "agent-evaluation",
    "behavior-testing",
    "regression-testing",
    "mcp",
    "model-context-protocol",
    "agent-governance",
    "guardrails",
    "ci",
    "typescript",
    "local-first"
  ],
  "author": "Christian Bucher",
  "contributors": [
    "Miguel (AI systems co-builder, under human review)"
  ],
  "license": "MIT",
  "files": [
    "dist/src",
    "docs",
    "!docs/README-nach-npm-release.*",
    "examples",
    "server.json",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christian140903-sudo/agent-invariants.git"
  },
  "bugs": {
    "url": "https://github.com/christian140903-sudo/agent-invariants/issues"
  },
  "homepage": "https://github.com/christian140903-sudo/agent-invariants#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "mcpName": "io.github.christian140903-sudo/agent-invariants"
}
